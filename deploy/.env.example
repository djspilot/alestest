# ALES Manufacturing Pipeline - Configuration
# Copy this file to .env and configure for your environment

# ---- VPS / Docker API (api.aidoel.nl) ----
# API key(s) for authentication. Comma-separated for multiple keys.
# Leave empty for no auth (dev mode only).
# API_KEYS=your-secret-key

# ---- Deploy script (deploy.sh) ----
# VPS_HOST=api.aidoel.nl
# VPS_USER=root
# VPS_DIR=/opt/manufacturing-api

# ---- Windows File Watcher (ERP integration) ----
# Folder to monitor for new STEP files
# Windows example: WATCHED_FOLDER=G:\ALES\Offerte-ALES
# Linux example: WATCHED_FOLDER=/mnt/ales/offerte
WATCHED_FOLDER=G:\ALES\Offerte-ALES

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable FreeCAD unfold functionality (True/False)
# Set to False if FreeCAD is not installed
ENABLE_UNFOLD=True

# Disable specific analysis stages (comma-separated)
# Valid keys: classify_geometry, detect_holes_pre_unfold, unfold, detect_holes, aag
# DISABLE_STAGES=unfold,classify_geometry

# FreeCAD installation path (Windows)
# Only needed if FreeCAD is in a non-standard location
# FREECAD_PATH=C:\Program Files\FreeCAD 1.0\bin

# VPS API configuration (for hybrid mode - watcher uploads to API)
# API_URL=https://api.aidoel.nl/api/v1
# API_KEY=your-api-key-here
