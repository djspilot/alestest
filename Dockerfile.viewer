FROM node:20-alpine AS build

WORKDIR /app
COPY viewer/package*.json /app/
RUN npm ci

COPY viewer /app

ARG VITE_PIPELINE_API_BASE_URL
ENV VITE_PIPELINE_API_BASE_URL=$VITE_PIPELINE_API_BASE_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx/viewer-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
