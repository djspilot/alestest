# ── Stage 0: build the React viewer ──────────────────────────────────────────
FROM node:20-alpine AS viewer-build

WORKDIR /viewer
COPY viewer/package*.json ./
RUN npm ci --legacy-peer-deps

COPY viewer ./

ARG VITE_PIPELINE_API_BASE_URL
ENV VITE_PIPELINE_API_BASE_URL=${VITE_PIPELINE_API_BASE_URL}

RUN npm run build

# ── Stage 1: API + cadquery-ocp + FreeCAD ─────────────────────────────────────
FROM mambaorg/micromamba:1.5.10

WORKDIR /app

# ── Env 1: API + cadquery-ocp (no FreeCAD → no VTK conflict) ──────────────────
COPY --chown=$MAMBA_USER:$MAMBA_USER requirements.txt /app/requirements.txt

# System libs required by cadquery-ocp (OCP kernel) on headless servers
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libice6 libsm6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

RUN micromamba create -y -n ales -c conda-forge python=3.11 pip libexpat && \
    micromamba run -n ales pip install --no-cache-dir -r /app/requirements.txt && \
    micromamba run -n ales pip install --no-cache-dir uvicorn && \
    micromamba clean --all --yes

# ── Env 2: FreeCAD only (isolated VTK, called via subprocess) ─────────────────
RUN micromamba create -y -n freecad -c conda-forge freecad && \
    micromamba clean --all --yes

COPY --chown=$MAMBA_USER:$MAMBA_USER . /app

# Embed the pre-built viewer so FastAPI can serve it at /
COPY --from=viewer-build /viewer/dist /app/manufacturing_pipeline/api/static

ENV PYTHONUNBUFFERED=1
ENV API_HOST=0.0.0.0
ENV API_PORT=8000
ENV UPLOAD_DIR=/srv/alestest/uploads
ENV DB_PATH=/srv/alestest/data/db/manufacturing_data.db
# Points freecad_runtime.py to the isolated conda env
ENV FREECAD_RUNTIME_ROOT=/opt/conda/envs/freecad

EXPOSE 8000

CMD ["/opt/conda/envs/ales/bin/python", "-m", "uvicorn", \
     "manufacturing_pipeline.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
