FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt /app/requirements.txt

RUN pip install --no-cache-dir -r /app/requirements.txt && \
    pip install --no-cache-dir uvicorn

COPY . /app

ENV PYTHONUNBUFFERED=1
ENV API_HOST=0.0.0.0
ENV API_PORT=8000
ENV UPLOAD_DIR=/srv/alestest/uploads
ENV DB_PATH=/srv/alestest/data/db/manufacturing_data.db
ENV FREECAD_RUNTIME_ROOT=/srv/alestest/runtime/freecad

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "manufacturing_pipeline.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
